{
  "name": "wifi-qa-virtual-lab",
  "version": "0.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/standalone.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests *.json *.ts *.js *.yaml README.md docs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
